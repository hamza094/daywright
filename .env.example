APP_NAME=DayWright
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
API_VERSION=0.3.1

# Sentry environment for frontend error tracking
# Options: development, staging, production
VITE_APP_ENV=development

# Sentry DSN for error monitoring
# Get this from your Sentry project settings
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Laravel Nightwatch backend monitoring
# Get the token from your Nightwatch dashboard
NIGHTWATCH_TOKEN=
NIGHTWATCH_REQUEST_SAMPLE_RATE=
# Comma-separated list of admin email addresses used by the application.
# Prefer setting this via your environment (the project's `.env` or `.env.testing`).
# Example: ADMIN_EMAILS=admin@example.com,security@example.com
ADMIN_EMAILS=admin@example.com,security@example.com

# CORS Configuration: Comma-separated list of allowed origins for API requests
# For local development, include your frontend URLs (e.g., http://localhost:3000)
# For production, include only your actual domain(s)
# Example: CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

LOG_CHANNEL=stack

BCRYPT_ROUNDS=12

DB_CONNECTION=mysql
# For Docker (Sail): use 'mysql'. For native local host: use '127.0.0.1'
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

MEMCACHED_HOST=127.0.0.1

BROADCAST_DRIVER=pusher
CACHE_DRIVER=redis
IDEMPOTENCY_TTL=3600
IDEMPOTENCY_REQUIRED=true
IDEMPOTENCY_SCOPE=user
IDEMPOTENCY_HEADER=Idempotency-Key
IDEMPOTENCY_LOCK_TIMEOUT=90

# Queue Connection
# For development and production with Laravel Horizon: 'redis'
# Options: 'sync' (run inline, dev only), 'redis' (Horizon)
# IMPORTANT: Never use 'sync' in production - jobs will block HTTP requests
QUEUE_CONNECTION=sync

SESSION_DRIVER=file
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000
SESSION_DOMAIN=localhost

# For Docker (Sail): use 'redis'. For native local host: use '127.0.0.1'
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

MAIL_FROM_ADDRESS=daywright@example.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

FILESYSTEM_CLOUD=s3

VONAGE_KEY=
VONAGE_SECRET=
VONAGE_SMS_FROM=

STRIPE_KEY=
STRIPE_SECRET=

PAYPAL_ID=
PAYPAL_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_URL=http://127.0.0.1:8000/auth/callback/github

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://127.0.0.1:8000/auth/callback/google

PADDLE_VENDOR_ID=
PADDLE_VENDOR_AUTH_CODE=
PADDLE_PUBLIC_KEY=""
PADDLE_SANDBOX=true
Monthly_Plan=
Yearly_Plan=
CASHIER_WEBHOOK=

VITE_ZOOM_SDK_KEY=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

OPENAI_API_KEY=
OPENAI_ORGANIZATION=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Playwright E2E smoke tests (tests/e2e)
# Seed deterministic accounts first: php artisan db:seed --class=E2eUserSeeder
PLAYWRIGHT_BASE_URL=http://127.0.0.1:8000
E2E_USER_EMAIL=e2e-user-a@daywright.test
E2E_USER_B_EMAIL=e2e-user-b@daywright.test
E2E_USER_PASSWORD=Berry@999
