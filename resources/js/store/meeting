
import { getObjectData, getPaginatedData, getResponseMessage, parseApiError } from '../utils/apiResponse.js';

const createEmptyMeetingPage = () => ({
  data: [],
  links: {},
  meta: {},
});

const state = {
  meetings: createEmptyMeetingPage(),
    message:'',
};

const mutations = {
setMeetings(state, meetingsPage) {
  state.meetings = meetingsPage;
  },

  UPDATE_MEETING_STATUS(state, { id, status }) {
    const index = state.meetings.data.findIndex(m => m.id === id);
    if (index !== -1) {
      state.meetings.data[index].status = status;
    }
  },

  setMessage(state,message) {
    state.message = message;
  },

  removeMeetingFromState(state, meetingId){
    const index = state.meetings.data.findIndex(meeting => meeting.id === meetingId);
    if (index !== -1) {
      state.meetings.data.splice(index, 1);
    }
  },

   addMeeting(state, meeting) {
    state.meetings.data.unshift(meeting);
  },

  meetingUpdate(state, updatedMeeting) {
    const index = state.meetings.data.findIndex(meeting => meeting.id === updatedMeeting.id);
    if (index !== -1) {
      state.meetings.data.splice(index, 1, updatedMeeting);
    }
  },
};

const actions = {
  fetchMeetings({ commit }, { slug, page, isPrevious }) {
    const params = isPrevious ? { request: 'previous', page } : { page };
    return axios.get(`/projects/${slug}/meetings`, { params })
      .then(response => {
        const meetings = getPaginatedData(response);

        commit('setMeetings', meetings);
        commit('setMessage', getResponseMessage(response) || (meetings.data.length === 0
          ? (isPrevious ? 'No previous meetings found.' : 'No meetings found.')
          : ''));
      })
      .catch(error => {
        commit('setMeetings', createEmptyMeetingPage());
        commit('setMessage', parseApiError(error).message || 'Failed to load project meetings');
      });
  },
   updateMeetingStatus({ commit }, { id, status }) {
    commit('UPDATE_MEETING_STATUS', { id, status });
  },
};

export default{
  namespaced: true,
  state,
  mutations,
  actions,
}
