import { getArrayData, getObjectData, getResponseMessage } from '../utils/apiResponse.js';

const state = {
  stages:[],
};

const mutations = {
  setStages(state,data){
    state.stages=data;
  },

  setErrors(state,error){
  },

  stageUpdate(state, updatedStage) {
    const index = state.stages.findIndex(stage => stage.id === updatedStage.id);
    if (index !== -1) {
      // Replace the existing stage with the updated stage
      state.stages.splice(index, 1, updatedStage);
    }
  },

  addStage(state, newStage)
  {
    state.stages.push(newStage);
  },

  stageDelete(state, stageIdToDelete) {
    state.stages = state.stages.filter(stage => stage.id !== stageIdToDelete);
  },
};

const actions = {
  loadStages({ commit }) {
    	return axios.get(`/admin/stages`)
        .then(response => {
        commit('setStages', getArrayData(response));
        })
        .catch(error => {
          throw error;
        })
      },

    async addNewStage({ commit }, stageData) {
    try {
      const response = await axios.post('/admin/stages', stageData);
      commit('addStage', getObjectData(response));
    } catch (error) {
      throw error; 
    }
  },

    async updateExistingStage({ commit }, { stageId, stageData }) {
    try {
      const response = await axios.put(`/admin/stages/${stageId}`, stageData);
      const stage = getObjectData(response);

      commit('stageUpdate', stage);

      return stage;
    } catch (error) {
      throw error;
    }
  },

    async deleteExistingStage({ commit }, stageId) {
    try {
      const response = await axios.delete(`/admin/stages/${stageId}`);

      commit('stageDelete', stageId);

      return getResponseMessage(response);
    } catch (error) {
      throw error;
    }
  },
};

export default{
  namespaced: true,
  state,
  mutations,
  actions,
}