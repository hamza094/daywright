import { getArrayData, getObjectData, getResponseMessage } from '../utils/apiResponse.js';

const state = {
  statuses:[],
};

const mutations = {
  setStatuses(state,data){
    state.statuses=data;
  },

  setErrors(state,error){
  },

  statusUpdate(state, updatedStatus) {
    const index = state.statuses.findIndex(status => status.id === updatedStatus.id);
    if (index !== -1) {
      // Replace the existing status with the updated status
      state.statuses.splice(index, 1, updatedStatus);
    }
  },

  addStatus(state, newStatus)
  {
    state.statuses.push(newStatus);
  },

  statusDelete(state, statusIdToDelete) {
    state.statuses = state.statuses.filter(status => status.id !== statusIdToDelete);
  },
};

const actions = {
  loadStatuses({ commit }) {
    	return axios.get(`/admin/statuses`)
        .then(response => {
        commit('setStatuses', getArrayData(response));
        })
        .catch(error => {
          throw error;
        })
      },

    async addNewStatus({ commit }, statusData) {
    try {
      const response = await axios.post('/admin/statuses', statusData);
      commit('addStatus', getObjectData(response));
    } catch (error) {
      throw error; 
    }
  },

    async updateExistingStatus({ commit }, { statusId, statusData }) {
    try {
      const response = await axios.put(`/admin/statuses/${statusId}`, statusData);
      const status = getObjectData(response);

      commit('statusUpdate', status);

      return status;
    } catch (error) {
      throw error;
    }
  },

    async deleteExistingStatus({ commit }, statusId) {
    try {
      const response = await axios.delete(`/admin/statuses/${statusId}`);

      commit('statusDelete', statusId);

      return getResponseMessage(response);
    } catch (error) {
      throw error;
    }
  },
};

export default{
  namespaced: true,
  state,
  mutations,
  actions,
}