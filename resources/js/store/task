import { getPaginatedData, getResponseMessage } from '../utils/apiResponse.js';
import { buildArchivedTaskParams, createEmptyTaskPage } from '../utils/taskReadResponse.js';

const state = {
  archive:'',
  message:'',
  tasks: createEmptyTaskPage(),
  archivedTasks: createEmptyTaskPage(),
};

const mutations = {
setTasks(state,tasks) {
    state.tasks = tasks;
  },
  setMessage(state,message) {
    state.message = message;
  },
  removeTaskFromState(state, taskId){
    const index = state.tasks.data.findIndex(task => task.id === taskId);
    if (index !== -1) {
      state.tasks.data.splice(index, 1);
    }
  },
   updateTask(state, updatedTask) {
    const index = state.tasks.data.findIndex(task => task.id === updatedTask.id);
    if (index !== -1) {
      state.tasks.data.splice(index, 1, updatedTask);
    }
  },

  setArchivedTasks(state, archivetasksData) {
    state.archivedTasks = archivetasksData;
  },
    setArchivedMessage(state, archive) {
    state.archive = archive;
  },
  pushArchivedTask(state, task){
        state.archivedTasks.data.unshift(task);
  },
  removeArchivedTask(state, taskId){
    const index = state.archivedTasks.data.findIndex(task => task.id === taskId);
    if (index !== -1) {
      state.archivedTasks.data.splice(index, 1);
    }
  },
};

const actions = {

    fetchTasks({ commit }, { slug, page }) {
	    return axios.get(`/projects/${slug}/tasks`, {
          params: { page },
        })
        .then(response => {
          commit('setTasks', getPaginatedData(response));
          commit('setMessage', getResponseMessage(response) || 'Project Tasks');
        }).catch(error=>{
        commit('setTasks', createEmptyTaskPage());
        commit('setMessage', 'Failed to load project tasks');
        });
    },

      loadArchiveTasks({ commit }, slug) {
     	return axios.get(`/projects/${slug}/tasks`,{
         params: buildArchivedTaskParams()
      }).then(response => { 
        commit('setArchivedTasks', getPaginatedData(response));
        commit('setMessage', getResponseMessage(response) || 'Archived Tasks');
        })
        .catch(error => {
        commit('setArchivedTasks', createEmptyTaskPage());
        commit('setMessage', 'Archived Tasks');
        })
      },
};

export default{
  namespaced: true,
  state,
  mutations,
  actions,
}
