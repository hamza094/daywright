import router from '../router.js';
import Vue from 'vue';
import { clearTwoFaState, markTwoFaPending, pushRoute, getErrorMessage } from '../utils/auth.js';
import { parseApiError } from '../utils/apiResponse.js';
import { isTwoFactorChallenge, parseAuthSession } from '../utils/authResponse.js';
import { setSentryUser, clearSentryUser } from '../sentry.js';

const normalizeFeatureFlags = (features) => {
  return features !== null && typeof features === 'object' && !Array.isArray(features) ? features : {};
};

const normalizeUser = (user, features = null) => {
  const baseUser = user ?? {};
  const mergedFeatures = normalizeFeatureFlags(features ?? baseUser.features);

  return {
    ...baseUser,
    features: mergedFeatures,
  };
};

const resetAuthState = (commit, dispatch) => {
  commit('setUser', {});
  commit('loggedIn', false);
  commit('clearErrors');
  clearSentryUser(); // Clear user on logout or expired session
  dispatch('subscribeUser/userLogout', null, { root: true });
  clearTwoFaState();
  try {
    localStorage.removeItem('vuex');
  } catch {
    // Storage unavailable or blocked; ignore safely
  }
};

const state = {
  user: {},
  errors: {},
  loggedIn: false,
  bootstrapped: false,
};

const getters = {};

const actions = {
  finalizeLogin({ commit, dispatch, state }, { response, vm, toastMsg }) {
    const { user, features } = parseAuthSession(response);

    // If an account was previously loaded and differs, reset module state before logging in new user
    if (state.user?.id && state.user.id !== user?.id) {
      dispatch('subscribeUser/userLogout', null, { root: true });
    }

    clearTwoFaState();
    try {
      localStorage.removeItem('vuex');
    } catch {
      // Storage unavailable or blocked; ignore safely
    }
    commit('setUser', normalizeUser(user, features));
    commit('loggedIn', true);
    commit('clearErrors');

    // Set Sentry user context on login
    setSentryUser(user);

    dispatch('subscribeUser/userSubscription', null, { root: true });
    if (toastMsg && vm?.$vToastify) vm.$vToastify.success(toastMsg);
    pushRoute(vm, '/dashboard', router);
  },

  handleLoginResponse({ dispatch }, response) {
    if (isTwoFactorChallenge(response)) {
      markTwoFaPending();
      pushRoute(null, { name: 'TwoFACode' }, router);
      return;
    }
    dispatch('finalizeLogin', { response });
  },

  async loginUser({ commit, dispatch }, user) {
    Vue.prototype.$Progress.start();
    try {
      await axios.get('/sanctum/csrf-cookie');
      const response = await axios.post('/session/login', user);
      dispatch('handleLoginResponse', response);
      Vue.prototype.$Progress.finish();
    } catch (error) {
      Vue.prototype.$Progress.fail();
      const { errors: validationErrors } = parseApiError(error);
      if (Object.keys(validationErrors).length > 0) {
        commit('setErrors', validationErrors);
      } else {
        commit('clearErrors');
        Vue.prototype.$vToastify.error(getErrorMessage(error));
      }
    }
  },

  async twoFactorLogin({ dispatch }, { code, vm }) {
    const response = await axios.post('/twofactor/login-confirm', { code });
    dispatch('finalizeLogin', { response, vm, toastMsg: '2FA successfully verified.' });
  },

  async logoutUser({ commit, dispatch }) {
    try {
      await axios.post('/session/logout');
    } catch (error) {
      Vue.prototype.$vToastify.error(getErrorMessage(error, 'Unable to log out.'));
    } finally {
      resetAuthState(commit, dispatch);
      pushRoute(null, '/login', router);
    }
  },

  deleteUser({ commit, dispatch }) {
    resetAuthState(commit, dispatch);
    router.push('/dashboard');
  },

  updateVerifiedStatus({ commit }, isVerified) {
    commit('setUserVerified', isVerified);
  },

  async bootstrapSession({ commit, dispatch, state }) {
    try {
      const response = await axios.get('/users/me');
      const { user, features } = parseAuthSession(response);

      if (user) {
        // If switching accounts or re-bootstrapping for a different user, clear prior module state
        if (state.user?.id && state.user.id !== user.id) {
          dispatch('subscribeUser/userLogout', null, { root: true });
        }

        commit('setUser', normalizeUser(user, features));
        commit('loggedIn', true);
        commit('clearErrors');

        // Set Sentry user context on page load / session bootstrap
        setSentryUser(user);

        try {
          await dispatch('subscribeUser/userSubscription', null, { root: true });
        } catch {
          // ignore subscription errors during bootstrap
        }
        return user;
      }

      resetAuthState(commit, dispatch);
      return null;
    } catch {
      resetAuthState(commit, dispatch);
      return null;
    } finally {
      commit('setBootstrapped', true);
    }
  },
};

const mutations = {
  setErrors(state, data) {
    state.errors = data || {};
  },
  clearErrors(state) {
    state.errors = {};
  },
  setUser(state, data) {
    state.user = normalizeUser(data, data?.features);
  },
  loggedIn(state, data) {
    state.loggedIn = data;
  },
  setBootstrapped(state, value) {
    state.bootstrapped = !!value;
  },
  setUserVerified(state, isVerified) {
    if (state.user) {
      state.user.verified = isVerified;
    }
  },
};

export default {
  namespaced: true,
  state,
  getters,
  actions,
  mutations,
};
