# ==============================================================================
# DayWright — Production Environment Variables Template
#
# Copy this file to .env.production on the EC2 host and fill in real values.
# DOMAIN must also be set in the project-root .env (or shell). Docker Compose
# reads it for YAML interpolation, NOT from .env.production.
# NEVER commit .env.production to version control.
# NEVER leave placeholder values in a live deployment.
#
# Location on EC2: /home/ubuntu/daywright/.env.production
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Core
# ------------------------------------------------------------------------------
APP_NAME=DayWright
APP_ENV=production
APP_KEY=                              # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://yourdomain.com        # Must be HTTPS; used by url() helpers
API_VERSION=0.3.1

# ------------------------------------------------------------------------------
# Logging
# Log to stderr so Docker captures it. 'stack' with 'stderr' channel works.
# ------------------------------------------------------------------------------
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ------------------------------------------------------------------------------
# Database — AWS RDS for MySQL (external, NOT in Compose)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=daywright
DB_USERNAME=daywright_user
DB_PASSWORD=                          # Strong random password

# ------------------------------------------------------------------------------
# Redis — internal Docker container (service name = 'redis')
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Queue — must be 'redis' for Horizon to work
# ------------------------------------------------------------------------------
QUEUE_CONNECTION=redis

# ------------------------------------------------------------------------------
# Cache — redis for performance
# ------------------------------------------------------------------------------
CACHE_DRIVER=redis

# ------------------------------------------------------------------------------
# Sessions — redis for multi-container consistency
# SESSION_SECURE_COOKIE=true because we are HTTPS-only
# SESSION_DOMAIN=.yourdomain.com (leading dot = all subdomains)
# SANCTUM_STATEFUL_DOMAINS = domain(s) the SPA runs on
# ------------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.yourdomain.com
SANCTUM_STATEFUL_DOMAINS=yourdomain.com,www.yourdomain.com

# ------------------------------------------------------------------------------
# Trusted Proxies
# No ALB: Nginx is the ONLY reverse proxy. It runs in the daywright Docker
# network (172.x.x.x). We trust the entire Docker bridge subnet so PHP
# correctly reads X-Forwarded-For from Nginx — but NOT from public clients.
# After deploying, confirm the subnet: docker network inspect daywright
# Common Docker default: 172.16.0.0/12
# ------------------------------------------------------------------------------
TRUSTED_PROXIES=172.16.0.0/12

# ------------------------------------------------------------------------------
# CORS — allow only your production domain
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ------------------------------------------------------------------------------
# AWS S3 — file storage (all uploads go here via FileService)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=your-s3-bucket-name
AWS_URL=https://your-s3-bucket-name.s3.us-east-1.amazonaws.com
AWS_USE_PATH_STYLE_ENDPOINT=false
FILESYSTEM_CLOUD=s3

# ------------------------------------------------------------------------------
# Mail
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="DayWright"

# ------------------------------------------------------------------------------
# Paddle Payments (REQUIRED — app throws LogicException on boot if missing)
# CASHIER_WEBHOOK must be HTTPS and must match your Paddle dashboard webhook URL
# ------------------------------------------------------------------------------
PADDLE_VENDOR_ID=
PADDLE_VENDOR_AUTH_CODE=
PADDLE_PUBLIC_KEY=""
PADDLE_SANDBOX=false                  # Set to false for real Paddle production
Monthly_Plan=
Yearly_Plan=
CASHIER_WEBHOOK=https://yourdomain.com/paddle/webhook

# ------------------------------------------------------------------------------
# Pusher / Broadcast
# ------------------------------------------------------------------------------
BROADCAST_DRIVER=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# ------------------------------------------------------------------------------
# OAuth Providers
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_URL=https://yourdomain.com/auth/callback/github

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=https://yourdomain.com/auth/callback/google

# ------------------------------------------------------------------------------
# Zoom Integration
# ------------------------------------------------------------------------------
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# ------------------------------------------------------------------------------
# OpenAI
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_ORGANIZATION=

# ------------------------------------------------------------------------------
# Vonage SMS
# ------------------------------------------------------------------------------
VONAGE_KEY=
VONAGE_SECRET=
VONAGE_SMS_FROM=

# ------------------------------------------------------------------------------
# Horizon
# HORIZON_NAME helps identify this instance in the Horizon UI
# ADMIN_EMAILS — comma-separated; controls who can access the Horizon dashboard
# ------------------------------------------------------------------------------
HORIZON_NAME=DayWright-Production
ADMIN_EMAILS=admin@yourdomain.com

# ------------------------------------------------------------------------------
# Idempotency (keep production defaults)
# ------------------------------------------------------------------------------
IDEMPOTENCY_TTL=3600
IDEMPOTENCY_REQUIRED=true
IDEMPOTENCY_SCOPE=user
IDEMPOTENCY_HEADER=Idempotency-Key
IDEMPOTENCY_LOCK_TIMEOUT=90

# ------------------------------------------------------------------------------
# Security / Hashing
# 12 rounds is the default; increase only if your server can handle the CPU cost
# ------------------------------------------------------------------------------
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# Monitoring (optional but recommended)
# ------------------------------------------------------------------------------
SENTRY_AUTH_TOKEN=
# ------------------------------------------------------------------------------
# Frontend Build-Time Variables (passed as Docker --build-arg during image build)
# Public values only — Vite inlines VITE_* variables into JS during npm run build.
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
VITE_APP_ENV=production
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=mt1
VITE_ZOOM_SDK_KEY=
VITE_SENTRY_DSN=
NIGHTWATCH_TOKEN=
NIGHTWATCH_REQUEST_SAMPLE_RATE=

# ------------------------------------------------------------------------------
# Domain env var (used by compose.production.yaml for cert paths)
# This variable is read by Docker Compose, not by Laravel itself.
# ------------------------------------------------------------------------------
DOMAIN=yourdomain.com
