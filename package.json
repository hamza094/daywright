{
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint *.js resources",
    "format": "prettier --write '**/*.{js,vue,css,scss,json,yml,md}'",
    "stylelint": "stylelint \"resources/sass/**/*.scss\"",
    "stylelint:fix": "stylelint \"resources/sass/**/*.scss\" --fix",
    "postinstall": "husky install",
    "dev:all": "concurrently \"php artisan serve --host=127.0.0.1 --port=8000\" \"npm run dev\""
  },
  "devDependencies": {
    "@vitejs/plugin-vue2": "^2.3.4",
    "axios": "^1.13.4",
    "bootstrap": "^4.6.2",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.7.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jquery": "^3.7.1",
    "laravel-vite-plugin": "^1.3.0",
    "lint-staged": "^16.2.7",
    "lodash": "^4.17.23",
    "prettier": "3.7.1",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.34.0",
    "sass-embedded": "^1.97.3",
    "sass-loader": "^8.0.2",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "vite": "^6.4.1",
    "vue": "^2.7.16",
    "vue2-slideout-panel": "^2.1.0"
  },
  "dependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@popperjs/core": "^2.11.8",
    "@saeris/vue-spinners": "^1.0.8",
    "@tabler/core": "^1.4.0",
    "@zoom/meetingsdk": "^4.1.0",
    "animate.css": "^4.1.1",
    "chart.js": "^2.9.4",
    "dompurify": "^3.3.1",
    "emoji-mart-vue-fast": "^15.0.5",
    "js-file-download": "^0.4.12",
    "laravel-echo": "^1.19.0",
    "laravel-vue-pagination": "^2.3.1",
    "luxon": "^1.28.1",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "portal-vue": "^3.0.0",
    "pusher-js": "^8.4.0",
    "sweetalert2": "^11.26.18",
    "v-calendar": "^3.1.2",
    "v-tooltip": "^1.1.6",
    "vue-bus": "^1.2.1",
    "vue-chartjs": "^3.5.1",
    "vue-cropperjs": "^4.2.0",
    "vue-datetime": "^0.7.1",
    "vue-js-modal": "^1.0.3",
    "vue-mention": "^1.1.0",
    "vue-progressbar": "^0.7.5",
    "vue-router": "^3.6.5",
    "vue-toastify": "^2.1.0",
    "vue-upload-component": "^2.8.23",
    "vue2-editor": "^1.0.1",
    "vuex": "^4.1.0",
    "vuex-persistedstate": "^4.1.0"
  },
  "lint-staged": {
    "*.js|resources/**/*.{vue,js}": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ],
    "**/*.{css,scss,json,yml,md}": [
      "prettier --write --ignore-unknown"
    ],
    "**/*.php": [
      "php vendor/bin/pint"
    ]
